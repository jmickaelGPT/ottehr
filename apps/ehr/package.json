{
  "name": "ehr-ui",
  "version": "1.36.35",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "start": "npm run start:iac",
    "start:iac": "node ../../scripts/run-vite-with-env-mode.cjs --default default --local-alias default",
    "start:labcorp": "cross-env ENV=labcorp-local npm run start",
    "preview": "vite preview --port 4002",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint --ext .ts,.tsx,.js,.jsx --report-unused-disable-directives --max-warnings 0 .",
    "lint:fix": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint --ext .ts,.tsx,.js,.jsx --report-unused-disable-directives --max-warnings 0 --fix .",
    "build": "concurrently --kill-others-on-fail \"tsc\" \"vite build --mode default\"",
    "build:env": "node ../../scripts/run-npm-script-with-env.cjs --script build-skeleton --env-name ENV --env-from npm_config_env",
    "build:local": "npm run build",
    "build:e2e": "cross-env ENV=e2e npm run build-skeleton",
    "build:e2e2": "cross-env ENV=e2e2 npm run build-skeleton",
    "build:e2e3": "cross-env ENV=e2e3 npm run build-skeleton",
    "build:development": "cross-env ENV=development npm run build-skeleton",
    "build:testing": "cross-env ENV=testing npm run build-skeleton",
    "build:staging": "cross-env ENV=staging npm run build-skeleton",
    "build:demo": "cross-env ENV=demo npm run build-skeleton",
    "build:production": "cross-env ENV=production npm run build-skeleton",
    "build-skeleton": "node ../../scripts/run-app-build-skeleton.cjs",
    "unit-tests": "vitest --config ./vitest.config.ts",
    "component-tests": "vitest --config ./vitest.config.component-tests.ts",
    "test": "npm run unit-tests -- --watch=false && npm run component-tests -- --watch=false",
    "e2e:login": "npm run e2e-skeleton ./tests/e2e/login",
    "e2e:specs": "node ../../scripts/run-e2e-specs.cjs ./tests/e2e/specs",
    "e2e:specs:ui": "node ../../scripts/run-e2e-specs.cjs ./tests/e2e/specs --ui",
    "e2e:manual-login": "node ./auth.setup.js",
    "e2e-skeleton": "node ../../scripts/run-e2e-skeleton.cjs",
    "setup-test-deps": "node setup-test-deps.js"
  },
  "dependencies": {
    "@fullcalendar/core": "^5.11.3",
    "@fullcalendar/daygrid": "^5.11.3",
    "@fullcalendar/list": "^5.11.3",
    "@fullcalendar/react": "^5.11.3",
    "@fullcalendar/timegrid": "^5.11.3",
    "@mui/icons-material": "^5.14.9",
    "@mui/x-data-grid-pro": "^6.3.0",
    "@mui/x-date-pickers-pro": "^6.3.0",
    "@stripe/react-stripe-js": "^3.0.0",
    "@stripe/stripe-js": "^3.5.0",
    "@twilio/conversations": "^2.4.1",
    "@types/utif": "^3.0.6",
    "@types/wavesurfer.js": "^6.0.12",
    "amazon-chime-sdk-component-library-react": "^3.10.0",
    "amazon-chime-sdk-js": "^3.20.0",
    "chart.js": "^4.4.1",
    "dwt": "^19.0.0",
    "fast-json-patch": "^3.1.1",
    "json-diff-ts": "^4.0.1",
    "notistack": "^3.0.1",
    "react-chartjs-2": "^5.2.0",
    "react-draggable": "^4.4.6",
    "react-easy-crop": "^5.0.8",
    "react-i18next": "^13.5.0",
    "react-idle-timer": "^5.7.2",
    "react-imask": "^7.6.1",
    "react-number-format": "^5.3.1",
    "react-page-visibility": "^7.0.0",
    "react-toastify": "^9.1.3",
    "react-window": "^1.8.10",
    "styled-components": "^5.3.11",
    "styled-system": "^5.1.5",
    "tsconfig": "*",
    "ui-components": "*",
    "utif": "^3.1.0",
    "utils": "*",
    "uuid": "^11.0.3",
    "wavesurfer.js": "^7.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/react-page-visibility": "^6.4.4",
    "@types/react-window": "^1.8.8",
    "@types/styled-components": "^5.1.34",
    "console-stamp": "^3.1.2",
    "csvtojson": "^2.0.10",
    "json-2-csv": "^5.5.1",
    "vitest": "^3.0.4"
  }
}
