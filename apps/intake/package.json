{
  "name": "intake-ui",
  "version": "1.36.35",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run start:iac",
    "start:local": "cross-env ENV=default npm run start",
    "start:demo": "cross-env ENV=demo npm run start",
    "start:labcorp": "cross-env ENV=labcorp-local npm run start",
    "start:iac": "node ../../scripts/run-vite-with-env-mode.cjs --default default",
    "start:local:iac": "cross-env ENV=default npm run start:iac",
    "start:demo:iac": "cross-env ENV=demo npm run start:iac",
    "build": "concurrently --kill-others-on-fail \"tsc\" \"vite build --mode default\"",
    "build:env": "node ../../scripts/run-npm-script-with-env.cjs --script build-skeleton --env-name ENV --env-from npm_config_env --extra ROBOTS_FILE=lowers",
    "build:local": "npm run build",
    "build:e2e": "cross-env ENV=e2e ROBOTS_FILE=lowers npm run build-skeleton",
    "build:e2e2": "cross-env ENV=e2e2 ROBOTS_FILE=lowers npm run build-skeleton",
    "build:e2e3": "cross-env ENV=e2e3 ROBOTS_FILE=lowers npm run build-skeleton",
    "build:development": "cross-env ENV=development ROBOTS_FILE=lowers npm run build-skeleton",
    "build:testing": "cross-env ENV=testing ROBOTS_FILE=lowers npm run build-skeleton",
    "build:staging": "cross-env ENV=staging ROBOTS_FILE=lowers npm run build-skeleton",
    "build:demo": "cross-env ENV=demo ROBOTS_FILE=lowers npm run build-skeleton",
    "build:production": "cross-env ENV=production ROBOTS_FILE=production npm run build-skeleton",
    "build-skeleton": "node ../../scripts/run-app-build-skeleton.cjs --copy-robots",
    "unit-tests": "vitest --config ./vitest.config.ts",
    "component-tests": "vitest --config ./vitest.config.component-tests.ts",
    "test": "npm run unit-tests -- --watch=false && npm run component-tests -- --watch=false",
    "list-distributions": "aws cloudfront list-distributions --query 'DistributionList.Items[*].Id' --output text",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint --ext .ts,.tsx,.js,.jsx --report-unused-disable-directives --max-warnings 0 .",
    "lint:fix": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint --ext .ts,.tsx,.js,.jsx --report-unused-disable-directives --max-warnings 0 --fix .",
    "e2e:login": "npm run e2e-skeleton ./tests/login/",
    "e2e:specs": "node ../../scripts/run-e2e-specs.cjs --project=e2e",
    "e2e:specs:ui": "node ../../scripts/run-e2e-specs.cjs --project=e2e --ui",
    "e2e:specs:legacy": "node ../../scripts/run-e2e-specs.cjs --project=chromium",
    "e2e:specs:legacy:in-person": "npm run e2e-skeleton -- --project=chromium ./tests/specs/in-person/ --ui",
    "e2e:specs:legacy:telemed": "npm run e2e-skeleton -- --project=chromium ./tests/specs/telemed/ --ui",
    "e2e:manual-login": "node ./auth.setup.js",
    "e2e-skeleton": "node ../../scripts/run-e2e-skeleton.cjs",
    "setup-test-deps": "node setup-test-deps.js"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "tsconfig": "*",
    "vite-plugin-istanbul": "^6.0.2",
    "vitest": "^3.0.4"
  },
  "dependencies": {
    "@mui/icons-material": "^5.11.16",
    "@stripe/react-stripe-js": "^3.0.0",
    "@stripe/stripe-js": "^3.5.0",
    "react-markdown": "^9.0.0",
    "ui-components": "*",
    "utils": "*"
  }
}
