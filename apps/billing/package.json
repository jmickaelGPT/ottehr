{
  "name": "billing-ui",
  "version": "1.36.35",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "start": "node ../../scripts/run-vite-with-env-mode.cjs --default default --local-alias default",
    "start:azure:dev": "cross-env ENV=azure-dev npm run start",
    "start:azure:beta": "cross-env ENV=azure-beta npm run start",
    "start:azure:production": "cross-env ENV=azure-production npm run start",
    "build": "tsc && vite build --mode default",
    "build:env": "node ../../scripts/run-npm-script-with-env.cjs --script build-skeleton --env-name ENV --env-from npm_config_env",
    "build:azure:dev": "cross-env ENV=azure-dev npm run build-skeleton",
    "build:azure:beta": "cross-env ENV=azure-beta npm run build-skeleton",
    "build:azure:production": "cross-env ENV=azure-production npm run build-skeleton",
    "build-skeleton": "node ../../scripts/run-app-build-skeleton.cjs",
    "lint": "eslint --ext .ts,.tsx --max-warnings 0 ."
  },
  "dependencies": {
    "@mui/icons-material": "^5.14.9",
    "@mui/lab": "^5.0.0-alpha.170",
    "@mui/x-data-grid-pro": "^6.3.0",
    "notistack": "^3.0.1",
    "tsconfig": "*",
    "utils": "*"
  }
}
